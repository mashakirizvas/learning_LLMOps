# Реальні ключі потрібні ЛИШЕ для реальної моделі (model-based evals, оцінка якості).
# Для mock — не потрібні; весь core проходиться без них.
#
# Щоб перемкнутися на реальний провайдер:
#   1) cp gateway/.env.example gateway/.env
#   2) впиши ключ нижче
#   3) підніми стек з реальною моделлю:
#        MODEL=gpt-5-mini   docker compose up    # OpenAI
#        MODEL=claude-haiku docker compose up    # Anthropic
# (детально — GETTING_STARTED.md → «Перемикання на реальний ключ»)

# --- OpenAI: моделі gpt-5-mini, gpt-5 ---
OPENAI_API_KEY=

# --- Anthropic: моделі claude-haiku, claude-sonnet ---
ANTHROPIC_API_KEY=

# --- Azure OpenAI: модель azure-gpt-5 ---
AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=
