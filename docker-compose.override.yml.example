# Порти зайняті? Скопіюй цей файл у docker-compose.override.yml —
# Compose підхопить його автоматично (звичайний docker compose up, без -f).
#
# ports при мержі Compose-файлів ДОДАЮТЬСЯ, а не замінюються, тому потрібен
# тег !override — інакше отримаєш обидва мапінги одночасно (старий і новий).
#
# ПОТРІБЕН COMPOSE 2.24+: тег !override з'явився саме там. На старішій
# версії він мовчки ігнорується, порти ДОДАЮТЬСЯ, і старий залишиться
# зайнятим. Перевірка: docker compose config | docker port <контейнер>.
#
# Файл не комітиться (.gitignore): CI очікує стандартні порти.
# Після зсуву всі команди гайду читаються з новим портом
# (наприклад, localhost:18080 замість localhost:8080).
services:
  ui:
    ports: !override ["14200:4200"]
  service:
    ports: !override ["18080:8080"]
  gateway:
    ports: !override ["14000:4000"]
  postgres:
    ports: !override ["15432:5432"]
  # redis піднімається лише з профілем advanced — розкоментуй, якщо 6379 зайнятий
  # redis:
  #   ports: !override ["16379:6379"]
