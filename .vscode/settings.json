{
  // Коментарі в стартері українські, а VS Code за замовчуванням підсвічує
  // «неоднозначні» символи — ті, що схожі на латинські (с, е, а, о, р, х).
  // Це захист від гомогліфів у коді з різних мов; у нас він дає жовту рамку
  // майже на кожному слові коментаря і заважає читати.
  //
  // Вимикаємо саме ці дві перевірки. Підсвічування НЕВИДИМИХ символів
  // лишається ввімкненим: воно ловить нульової ширини пробіли, які справді
  // ламають код і яких на око не видно.
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false
}
